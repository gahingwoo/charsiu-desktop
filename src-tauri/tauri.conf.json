{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Charsiu Desktop",
  "mainBinaryName": "charsiu-desktop",
  "version": "0.3.0",
  "identifier": "com.gahingwoo.charsiu-desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Charsiu Desktop",
        "width": 1200,
        "height": 800,
        "minWidth": 720,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "deb",
      "appimage"
    ],
    "category": "Utility",
    "shortDescription": "Chat with a model on the RK3576 NPU",
    "longDescription": "A desktop chat window for charsiu. It starts charsiu serve on 127.0.0.1 and talks to it over charsiu's OpenAI compatible endpoint, on Windows on Arm (rknpu.sys) and on Linux (the rocket driver).",
    "license": "GPL-2.0-only",
    "copyright": "Copyright (c) 2026 gahingwoo",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "SimpChinese"
        ],
        "displayLanguageSelector": false
      }
    },
    "linux": {
      "deb": {
        "section": "utils"
      }
    }
  }
}
